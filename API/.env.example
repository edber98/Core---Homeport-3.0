# ───────────────────────────────────────────────────────────────────────────
# Kinn — exemple de configuration env
# Copie en `.env` et remplis les valeurs avant de démarrer.
# Toute var listée ici est lue par API/src/config/env.js (ou directement dans
# le code via process.env).
# ───────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────
PORT=5055
NODE_ENV=development
# URL publique du backend (utilisée par le HTTP trigger pour générer les URLs)
KINN_PUBLIC_URL=http://localhost:5055
# URL publique du frontend (redirect post-SSO callback)
FRONTEND_BASE_URL=http://localhost:5050

# ── Auth (JWT interne, chiffrement, etc.) ─────────────────────────────────
# OBLIGATOIRES en prod : générez via `openssl rand -hex 32`
HMAC_SECRET=dev-secret-change-me-32-chars-min
ENC_KEY=dev-enc-key-change-me-32-chars-min
TOKEN_TTL_SEC=86400

# ── MongoDB ───────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kinn

# ── Seed (dev/staging — désactivez SEED=0 en prod) ────────────────────────
SEED=1
SEED_COMPANIES=ACME,BETA
# Si défini ET qu'on est dans un seed neuf (DB vide), la 1ère company seedée
# reçoit ce zitadelOrgId. Pratique pour bind direct au déploiement SaaS.
SEED_COMPANY_ZITADEL_ORG_ID=
# Crée les users démo (admin/alice/demo). Mets =0 en prod SaaS avec SSO :
# le 1er admin sera auto-provisionné via JIT au 1er login Zitadel.
SEED_DEMO_USERS=1
# Crée system@kinn.local + son service token (plugin Kinn auto-référence).
# Mets =0 si tu n'utilises pas ce plugin (la plupart des prod SaaS).
LOCAL_SERVICE_TOKEN_ENABLED=1
DEFAULT_COMPANY=ACME
DEFAULT_ADMIN_EMAIL=admin@acme.test
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_WORKSPACE_NAME=Default

# ── Plugin import (manifests → DB) ────────────────────────────────────────
PLUGIN_IMPORT_ENABLED=1
# Liste de repos plugins à cloner au boot (séparés par des virgules)
# Format : <name>=<git-url>[#branch], <name>=<local-path>
PLUGIN_REPOS=
# Supprime de la DB les plugins absents des manifests au boot (1 = actif)
PLUGIN_CLEANUP_ENABLED=0

# ── HTTP Trigger ──────────────────────────────────────────────────────────
# Limite par IP, défaut 120 req/min
HTTP_TRIGGER_RATE_LIMIT_PER_MIN=120

# ── SSO Zitadel (injecté par Kinn-panel à l'install — laisse vide en local) ──
# SSO_MODE: 'disabled' (défaut, login email/pwd seul) | 'hybrid' (les deux) | 'enforced' (SSO obligatoire)
SSO_MODE=disabled
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_PROJECT_ID=
# REDIRECT_URI / POST_LOGOUT_URI : facultatifs.
# Si vides, calculés automatiquement depuis KINN_PUBLIC_URL et FRONTEND_BASE_URL.
# Doivent matcher EXACTEMENT ce qui est déclaré dans l'app OIDC Zitadel.
ZITADEL_REDIRECT_URI=
ZITADEL_POST_LOGOUT_URI=
# Secret partagé pour valider les webhooks /internal/* poussés par Kinn-panel
KINN_PANEL_HMAC_SECRET=
# Mapping rôles Zitadel → Kinn. Vide = 1:1 (admin→admin, editor→editor, viewer→viewer).
# Format : "zitadelRole:kinnRole,...". Utilise "*:role" pour le fallback (défaut editor).
# Exemple : SSO_ROLE_MAP=superadmin:admin,poweruser:editor,readonly:viewer,*:viewer
SSO_ROLE_MAP=

# ── OAuth Bouncer (concentrateur auth.kinn.fr) ────────────────────────────
# Clé HS256 PARTAGÉE avec le panel + toute la flotte. Générer 1x: openssl rand -hex 32
# DOIT être identique partout (sinon le panel ne peut vérifier les state JWT).
KINN_OAUTH_RELAY_SECRET=
# URL du concentrateur. redirect_uri = ${URL}/oauth/<vendor>/callback
KINN_OAUTH_CONCENTRATOR_URL=https://auth.kinn.fr
# Identifiants OAuth par vendor (1 app enregistrée par vendor chez le provider).
# Ne remplir que les vendors réellement utilisés par les plugins.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
# TikTok utilise client_key (et non client_id).
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=

# ── AI / LLM ──────────────────────────────────────────────────────────────
# Si les deux clés sont définies, Anthropic prend la priorité (cf. config/env.js)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=16384
AI_REASONING_EFFORT=none
AI_VERBOSITY=medium
AI_DEBUG=0
# Force Chat Completions API (sinon Responses API)
AI_FORCE_CHAT_COMPLETIONS=0
# Mini-modèle pour les recherches web rapides
WEB_MINI_PROVIDER=
WEB_MINI_MODEL=
# Sandbox des sub-agents : 'shared' (défaut) ou 'isolated' (worktree par agent — non impl.)
AI_AGENT_WORKTREE_MODE=shared
# Public access (no auth) pour les forms/flows AI partagés — défaut 0 (privé)
AI_FORM_ALLOW_PUBLIC=0
AI_FLOW_ALLOW_PUBLIC=0
AI_FLOW_NODE_WIDTH=320
AI_FLOW_NODE_HEIGHT=160
AI_FLOW_USE_ELK=1

# ── IA locale (vLLM / Ollama / LM Studio — endpoint OpenAI-compatible) ─────
# AI_BASE_URL = URL du serveur (ex http://192.168.1.10:8000/v1). Si défini,
# AI_PROVIDER bascule automatiquement sur 'vllm'. VLLM_BASE_URL = alias.
AI_BASE_URL=
VLLM_BASE_URL=
# Modèle exposé par le serveur local (VLLM_MODEL ou alias AI_MODEL_VLLM).
VLLM_MODEL=
AI_MODEL_VLLM=
# Clé API (vLLM accepte souvent n'importe quoi → 'local').
VLLM_API_KEY=local
# Plafond de tokens en sortie côté serveur local (0 = pas de limite imposée).
VLLM_MAX_TOKENS=0

# ── IA avancé (toggles — vide = défaut du code) ───────────────────────────
AI_DEFAULT_MAX_LOOPS=100
AI_PARALLEL_TOOL_CALLS=0
AI_MAX_SUBAGENT_DEPTH=3
AI_STREAM_TIMEOUT_MS=240000
AI_SUBAGENT_HEARTBEAT_TIMEOUT_MS=180000
SUBAGENT_DEPS_TIMEOUT_MS=3600000
AI_ENABLE_THINKING=0
AI_DISABLE_DOC_WRITER=0
AI_DISABLE_MEMORY_EXTRACTOR=0
AI_DISABLE_SUBAGENT_ASYNC=0
AGENT_USE_QUEUE=0
AI_RESUME_WORKER_INTERVAL_MS=
AI_CACHE_ROOT=
AI_CACHE_CLEANUP_CRON=
AI_MODEL_LIMITS=

# ── Sandbox d'exécution de code IA (execute_code / install_package) ───────
AI_SANDBOX_BACKEND=subprocess
AI_SANDBOX_PYTHON=python3
AI_SANDBOX_PY_SITE_PACKAGES=/data/sandbox-pkgs
AI_SANDBOX_PIP=
SKILLS_BUNDLE_DIR=/app/skills-bundle
AI_PACKAGE_INSTALL_MODE=ask
AI_PACKAGE_INSTALL_MAX_PER_DAY=20
AI_PACKAGE_WHITELIST=
AI_PACKAGE_BLACKLIST=

# ── Outils Web de l'agent IA (web_search / web_fetch / browser) ───────────
# WEB_MINI_* : mini-LLM dédié au résumé de pages. Vide = hérite de AI_BASE_URL/VLLM.
WEB_MINI_BASE_URL=
WEB_MINI_API_KEY=
WEB_SEARCH_ENGINE=bing
WEB_SEARCH_FALLBACK=brave
WEB_SEARCH_TIMEOUT_MS=40000
WEB_HTTP_TIMEOUT_MS=30000
WEB_BROWSER_TIMEOUT_MS=30000
WEB_FETCH_MAX_BYTES=5242880
WEB_FETCH_MAX_RAW_CHARS=80000

# ── Redis (events temps réel / queue agents — optionnel) ──────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── File storage ──────────────────────────────────────────────────────────
FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=./data/files
FILE_MAX_SIZE=200mb
FILE_TTL_DEFAULT=24h
FILE_CLEANUP_INTERVAL=1h
FILE_EXECUTION_CLEANUP_DELAY=30m
# S3 (si FILE_STORAGE_TYPE=s3)
FILE_S3_BUCKET=
FILE_S3_REGION=us-east-1
FILE_S3_ACCESS_KEY=
FILE_S3_SECRET_KEY=
FILE_S3_ENDPOINT=

# ── Webhooks (sortants — système Settings → Webhooks) ─────────────────────
WEBHOOK_BASE_URL=http://localhost:5055
# URL publique utilisée par l'adaptateur de triggers Kinn (fallback PUBLIC_URL).
# Si vides → calculées depuis KINN_PUBLIC_URL / PORT.
PUBLIC_URL=
HOMEPORT_PUBLIC_URL=

# ── Plugin Kinn local (auto-référence) ────────────────────────────────────
# Optionnel : si vide, le plugin Kinn local génère un service token au boot
KINN_LOCAL_BASE_URL=http://localhost:5055
KINN_LOCAL_API_TOKEN=
KINN_LOCAL_WORKSPACE_ID=

# ── Sécurité ──────────────────────────────────────────────────────────────
# Autorise le SSRF vers IPs privées (dev only, jamais en prod)
SSRF_ALLOW_PRIVATE=0

# ── CI / Tests ────────────────────────────────────────────────────────────
# Désactive Mongo + start in-memory (pour les tests)
CI_NO_DB=0
