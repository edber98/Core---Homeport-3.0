      "outputHandles": [
        {
          "id": "ok",
          "name": "Premier",
          "type": "payload",
          "schema": {
            "fields": [
              {
                "key": "type",
                "type": "text",
                "label": "Type"
              },
              {
                "key": "winner",
                "type": "text",
                "label": "Branche gagnante"
              },
              {
                "key": "arrived",
                "type": "number",
                "label": "Branches arrivées"
              },
              {
                "key": "expected",
                "type": "number",
                "label": "Branches attendues"
              }
            ]
          }
        }
      ],
      "args": {
        "title": "Course",
        "ui": {
          "layout": "vertical",
          "labelsOnTop": true
        },
        "fields": [],
