{
  "repo": {
    "name": "logic",
    "type": "local",
    "label": "Logique"
  },
  "providers": [
    {
      "key": "logic",
      "name": "Logique",
      "title": "Opérations logiques",
      "order": 2,
      "iconClass": "fa-solid fa-diagram-project",
      "color": "#334155",
      "tags": [
        "logic",
        "core"
      ],
      "hasCredentials": false
    }
  ],
  "nodeTemplates": [
    {
      "key": "condition",
      "name": "condition",
      "schemaVersion": 2,
      "title": "Condition",
      "subtitle": "Multi-branch",
      "type": "condition",
      "category": "Logic",
      "providerKey": "logic",
      "icon": "fa-solid fa-code-branch",
      "output_array_field": "items",
      "description": "Branche selon une condition",
      "args": {
        "title": "Conditions",
        "ui": {
          "layout": "vertical",
          "labelsOnTop": true
        },
        "fields": [
          {
            "type": "select",
            "key": "evaluation_mode",
            "label": "Mode d'évaluation",
            "description": "Exclusif : if / else if / else (première branche qui matche). Cumulatif : toutes les branches qui matchent se déclenchent en parallèle.",
            "default": "exclusive",
            "options": [
              {
                "label": "Exclusif — première branche qui matche",
                "value": "exclusive"
              },
              {
                "label": "Cumulatif — toutes les branches qui matchent (parallèle)",
                "value": "parallel"
              }
            ],
            "col": {
              "xs": 24
            }
          },
          {
            "type": "section",
            "title": "Branches",
            "description": "Définissez les branches et leurs conditions.",
            "key": "items",
            "mode": "array",
            "array": {
              "initialItems": 1,
              "minItems": 0,
              "controls": {
                "add": {
                  "kind": "text",
                  "text": "Ajouter"
                },
                "remove": {
                  "kind": "text",
                  "text": "Supprimer"
                }
              }
            },
            "fields": [
              {
                "type": "text",
                "key": "name",
                "label": "Nom",
                "description": "Nom lisible de la branche.",
                "col": {
                  "xs": 24,
                  "sm": 24,
                  "md": 24,
                  "lg": 24,
                  "xl": 24
                },
                "default": "",
                "expression": {
                  "allow": true
                },
                "validators": [
                  {
                    "type": "required"
                  }
                ]
              },
              {
                "type": "text",
                "key": "condition",
                "label": "Condition",
                "description": "Expression évaluée pour activer la branche.",
                "col": {
                  "xs": 24,
                  "sm": 24,
                  "md": 24,
                  "lg": 24,
                  "xl": 24
                },
                "default": "",
                "expression": {
                  "allow": true
                },
                "validators": [
                  {
                    "type": "required"
                  }
                ]
              }
            ],
            "col": {
              "xs": 24,
              "sm": 24,
              "md": 24,
              "lg": 24,
              "xl": 24
            },
            "grid": {
              "gutter": 16
            },
            "ui": {
              "layout": "vertical"
            }
          },
          {
            "type": "checkbox",
            "key": "else_enabled",
            "label": "Activer Else",
            "description": "Ajouter une branche par défaut, déclenchée quand AUCUNE condition ne matche (s'applique aux deux modes).",
            "col": {
              "xs": 24
            },
            "default": false
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "authorize_catch_error": false,
      "authorize_skip_error": false,
      "risk": "safe",
      "riskReason": "Évaluation de condition, pas d'effet de bord"
    },
    {
      "key": "loop",
      "name": "loop",
      "schemaVersion": 2,
      "title": "Boucle",
      "subtitle": "For-each",
      "type": "loop",
      "category": "Logic",
      "providerKey": "logic",
      "icon": "fa-solid fa-arrows-rotate",
      "description": "Itérer sur une collection et exécuter une branche pour chaque élément.",
      "inputHandles": [
        {
          "id": "in",
          "name": "In",
          "type": "payload",
          "accepts": [
            "payload",
            "any"
          ]
        },
        {
          "id": "items",
          "name": "Items",
          "type": "payload",
          "multiple": true,
          "accepts": [
            "payload",
            "any"
          ]
        }
      ],
      "outputHandles": [
        {
          "id": "after",
          "name": "After",
          "type": "payload"
        },
        {
          "id": "each",
          "name": "Each",
          "type": "payload"
        }
      ],
      "args": {
        "title": "Loop",
        "ui": {
          "layout": "vertical",
          "labelsOnTop": true
        },
        "fields": [
          {
            "type": "text",
            "key": "itemsArg",
            "label": "Tableau ou chemin (JSON/chemin)",
            "description": "Tableau d’entrée ou chemin JSON vers celui-ci.",
            "expression": {
              "allow": true
            },
            "col": {
              "xs": 24
            }
          },
          {
            "type": "text",
            "key": "elementExpr",
            "label": "Mapper l'élément (optionnel)",
            "description": "Expression pour transformer chaque élément.",
            "expression": {
              "allow": true
            },
            "col": {
              "xs": 24
            }
          },
          {
            "type": "text",
            "key": "itemVar",
            "label": "Nom de la variable élément",
            "description": "Nom de la variable représentant l’élément.",
            "default": "item",
            "col": {
              "xs": 12
            }
          },
          {
            "type": "text",
            "key": "indexVar",
            "label": "Nom de la variable index",
            "description": "Nom de la variable représentant l’index.",
            "default": "index",
            "col": {
              "xs": 12
            }
          },
          {
            "type": "checkbox",
            "key": "perItemPayload",
            "label": "Définir payload = élément pour la branche",
            "description": "Transmet l’élément comme payload dans la branche.",
            "default": true,
            "col": {
              "xs": 24
            }
          },
          {
            "type": "select",
            "key": "resultMode",
            "label": "Résultat final",
            "description": "Mode d’agrégation des résultats.",
            "options": [
              {
                "label": "Collecter tous les payloads",
                "value": "collect"
              },
              {
                "label": "Conserver le dernier payload",
                "value": "last"
              }
            ],
            "default": "collect",
            "col": {
              "xs": 24
            }
          },
          {
            "type": "number",
            "key": "maxIterations",
            "label": "Itérations max",
            "description": "Nombre maximum d’itérations.",
            "default": 1000,
            "col": {
              "xs": 24
            }
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "authorize_catch_error": false,
      "authorize_skip_error": false,
      "risk": "elevated"
    },
    {
      "key": "core_barrier",
      "name": "core_barrier",
      "schemaVersion": 2,
      "title": "Attendre tous",
      "subtitle": "Barrière",
      "type": "barrier",
      "category": "Logic",
      "providerKey": "logic",
      "icon": "fa-solid fa-arrows-down-to-line",
      "description": "Attend que toutes les branches arrivent avant de continuer. Fusionne les résultats de chaque branche.",
      "inputHandles": [
        {
          "id": "in",
          "name": "In",
          "type": "any",
          "multiple": true,
          "accepts": [
            "any",
            "payload"
