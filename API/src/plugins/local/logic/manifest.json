        }
      ],
      "outputHandles": [
        {
          "id": "ok",
          "name": "Fusionné",
          "type": "payload",
          "schema": {
            "fields": [
              {
                "key": "type",
                "type": "text",
                "label": "Type"
              },
              {
                "key": "arrived",
                "type": "number",
                "label": "Branches arrivées"
              },
              {
                "key": "expected",
                "type": "number",
                "label": "Branches attendues"
              }
            ]
          }
        }
      ],
      "args": {
        "title": "Barrière",
        "ui": {
          "layout": "vertical",
          "labelsOnTop": true
        },
        "fields": [],
        "displayTitle": false,
        "displayDescription": false
      },
      "authorize_catch_error": false,
      "authorize_skip_error": false,
      "risk": "safe",
      "riskReason": "Synchronisation, pas d'effet de bord"
    },
    {
      "key": "core_race",
      "name": "core_race",
      "schemaVersion": 2,
      "title": "Premier arrivé",
      "subtitle": "Course",
      "type": "race",
      "category": "Logic",
      "providerKey": "logic",
      "icon": "fa-solid fa-flag-checkered",
      "description": "Continue dès que la première branche arrive. Les autres branches sont ignorées.",
      "inputHandles": [
        {
          "id": "in",
          "name": "In",
          "type": "any",
          "multiple": true,
          "accepts": [
            "any",
            "payload"
          ]
