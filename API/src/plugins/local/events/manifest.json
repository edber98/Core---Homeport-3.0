        "fields": [
          {
            "type": "cron",
            "key": "expression",
            "label": "Expression cron",
            "description": "Ex: */5 * * * * (toutes les 5 min), 0 9 * * * (chaque jour à 9h), 0 0 1 * * (le 1er du mois).",
