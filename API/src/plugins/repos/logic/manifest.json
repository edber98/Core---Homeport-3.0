        { "type": "number", "key": "timeoutMs", "label": "Timeout (ms)", "default": 0, "col": { "xs": 24 } },
        { "type": "select", "key": "onTimeout", "label": "Sur timeout", "options": [ {"label":"error","value":"error"}, {"label":"continue","value":"continue"} ], "default": "error", "col": { "xs": 24 } }
