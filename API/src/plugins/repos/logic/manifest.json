      "schemaVersion": 2,
      "title": "Condition",
      "subtitle": "Branchements",
      "type": "condition",
      "category": "Logique",
      "providerKey": "logic",
      "description": "Branches multiples via items",
      "args": {
        "title": "Conditions",
        "ui": { "layout": "vertical" },
        "fields": [
          { "type": "section", "title": "Les conditions", "mode": "array", "key": "items", "array": { "initialItems": 1, "minItems": 0 }, "fields": [
            { "type": "text", "key": "name", "label": "Nom", "col": { "xs": 24, "md": 12 } },
            { "type": "text", "key": "expression", "label": "Expression", "col": { "xs": 24, "md": 12 } },
            { "type": "text", "key": "_id", "label": "Id (optionnel)", "col": { "xs": 24 }, "visibleIf": { "==": [ { "var": "name" }, "admin_id_viewer" ] } }
          ] }
        ]
      }
    },
