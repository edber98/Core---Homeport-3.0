{
  "repo": {
    "name": "firebase",
    "type": "local",
    "label": "Firebase"
  },
  "variables": {
    "firebase_firestore_document": {
      "title": "Document Firestore",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "name", "label": "Nom complet", "col": { "xs": 24 } },
        { "type": "text", "key": "path", "label": "Chemin", "col": { "xs": 24 } },
        { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
        { "type": "textarea", "key": "fields", "label": "Champs JSON", "col": { "xs": 24 } },
        { "type": "date", "key": "createTime", "label": "Date de création", "col": { "xs": 24 } },
        { "type": "date", "key": "updateTime", "label": "Date de modification", "col": { "xs": 24 } }
      ]
    },
    "firebase_firestore_documents": {
      "title": "Documents Firestore",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "number", "key": "totalCount", "label": "Nombre total", "col": { "xs": 24 } },
        { "type": "text", "key": "nextPageToken", "label": "Jeton page suivante", "col": { "xs": 24 } },
        { "type": "section", "title": "Documents", "key": "documents", "mode": "array", "array": { "initialItems": 0, "minItems": 0 }, "fields": [
          { "type": "text", "key": "name", "label": "Nom complet", "col": { "xs": 24 } },
          { "type": "text", "key": "path", "label": "Chemin", "col": { "xs": 24 } },
          { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
          { "type": "textarea", "key": "fields", "label": "Champs JSON", "col": { "xs": 24 } }
        ], "col": { "xs": 24 } }
      ]
    },
    "firebase_message": {
      "title": "Message Firebase",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "name", "label": "Nom", "col": { "xs": 24 } },
        { "type": "text", "key": "success", "label": "Succès", "col": { "xs": 24 } }
      ]
    },
    "firebase_rtdb_value": {
      "title": "Valeur Realtime Database",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "path", "label": "Chemin", "col": { "xs": 24 } },
        { "type": "textarea", "key": "value", "label": "Valeur JSON", "col": { "xs": 24 } },
        { "type": "text", "key": "success", "label": "Succès", "col": { "xs": 24 } }
      ]
    },
    "firebase_result": {
      "title": "Résultat Firebase",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
        { "type": "text", "key": "path", "label": "Chemin", "col": { "xs": 24 } },
        { "type": "text", "key": "success", "label": "Succès", "col": { "xs": 24 } }
      ]
    }
  },
  "providers": [
    {
      "key": "firebase",
      "name": "Firebase",
      "title": "Firebase",
      "iconUrl": "https://cdn.simpleicons.org/firebase",
      "iconClass": "fa-solid fa-fire",
      "color": "#ffca28",
      "tags": ["firebase", "google", "database", "push"],
      "categories": ["Développement"],
      "hasCredentials": true,
      "credentialsForm": {
        "title": "Identifiants Firebase",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "projectId", "label": "ID projet", "description": "Identifiant du projet Firebase.", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
          { "type": "text", "key": "databaseId", "label": "ID base Firestore", "default": "(default)", "col": { "xs": 24 } },
          { "type": "text", "key": "databaseUrl", "label": "URL Realtime Database", "description": "Exemple : https://mon-projet-default-rtdb.europe-west1.firebasedatabase.app", "col": { "xs": 24 } },
          { "type": "text", "key": "clientId", "label": "Client ID OAuth", "col": { "xs": 24 } },
          { "type": "text", "key": "clientSecret", "label": "Client secret OAuth", "secret": true, "col": { "xs": 24 } },
          { "type": "text", "key": "refreshToken", "label": "Refresh token OAuth", "secret": true, "col": { "xs": 24 } },
          { "type": "text", "key": "accessToken", "label": "Access token temporaire", "description": "Optionnel, utile pour tester sans refresh token.", "secret": true, "col": { "xs": 24 } }
        ],
        "displayTitle": false,
        "displayDescription": false
      }
    }
  ],
  "nodeTemplates": [
    {
      "key": "firebase_firestore_document_get",
      "name": "firebaseFirestoreDocumentGet",
      "schemaVersion": 2,
      "title": "Récupérer un document",
      "subtitle": "Firestore",
      "icon": "fa-solid fa-file-lines",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["lecture", "firestore"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_firestore_document" }],
      "authorize_catch_error": true,
      "description": "Récupère un document Firestore.",
      "args": { "fields": [
        { "type": "text", "key": "documentPath", "label": "Chemin du document", "description": "Exemple : users/abc123", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
        { "type": "text", "key": "databaseId", "label": "ID base", "col": { "xs": 24 } }
      ] },
      "group": "Firestore"
    },
    {
      "key": "firebase_firestore_documents_list",
      "name": "firebaseFirestoreDocumentsList",
      "schemaVersion": 2,
      "title": "Lister les documents",
      "subtitle": "Firestore",
      "icon": "fa-solid fa-list",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["lecture", "firestore"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_firestore_documents" }],
      "authorize_catch_error": true,
      "description": "Liste les documents d'une collection Firestore.",
      "args": { "fields": [
        { "type": "text", "key": "collectionPath", "label": "Chemin de collection", "description": "Exemple : users ou users/abc/orders", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
        { "type": "text", "key": "databaseId", "label": "ID base", "col": { "xs": 24 } },
        { "type": "number", "key": "pageSize", "label": "Taille page", "default": 50, "col": { "xs": 12 } },
        { "type": "text", "key": "pageToken", "label": "Jeton page", "col": { "xs": 24 } },
        { "type": "text", "key": "orderBy", "label": "Tri", "description": "Exemple : createdAt desc", "col": { "xs": 24 } }
      ] },
      "group": "Firestore"
    },
    {
      "key": "firebase_firestore_document_create",
      "name": "firebaseFirestoreDocumentCreate",
      "schemaVersion": 2,
      "title": "Créer un document",
      "subtitle": "Firestore",
      "icon": "fa-solid fa-plus",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["création", "firestore"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_firestore_document" }],
      "authorize_catch_error": true,
      "description": "Crée un document Firestore dans une collection.",
      "args": { "fields": [
        { "type": "text", "key": "collectionPath", "label": "Chemin de collection", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
        { "type": "text", "key": "documentId", "label": "ID document", "description": "Optionnel.", "col": { "xs": 24 } },
        { "type": "text", "key": "databaseId", "label": "ID base", "col": { "xs": 24 } },
        { "type": "textarea", "key": "fields", "label": "Champs JSON", "validators": [{ "type": "required" }], "col": { "xs": 24 } }
      ] },
      "group": "Firestore"
    },
    {
      "key": "firebase_firestore_document_update",
      "name": "firebaseFirestoreDocumentUpdate",
      "schemaVersion": 2,
      "title": "Modifier un document",
      "subtitle": "Firestore",
      "icon": "fa-solid fa-pen",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["modification", "firestore"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_firestore_document" }],
      "authorize_catch_error": true,
      "description": "Modifie un document Firestore.",
      "args": { "fields": [
        { "type": "text", "key": "documentPath", "label": "Chemin du document", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
        { "type": "text", "key": "databaseId", "label": "ID base", "col": { "xs": 24 } },
        { "type": "textarea", "key": "fields", "label": "Champs JSON", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
        { "type": "textarea", "key": "updateMask", "label": "Champs à modifier", "description": "Une clé par ligne. Vide pour envoyer tous les champs.", "col": { "xs": 24 } }
      ] },
      "group": "Firestore"
    },
    {
      "key": "firebase_firestore_document_delete",
      "name": "firebaseFirestoreDocumentDelete",
      "schemaVersion": 2,
      "title": "Supprimer un document",
      "subtitle": "Firestore",
      "icon": "fa-solid fa-trash",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["suppression", "firestore"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_result" }],
      "authorize_catch_error": true,
      "description": "Supprime un document Firestore.",
      "args": { "fields": [
        { "type": "text", "key": "documentPath", "label": "Chemin du document", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
        { "type": "text", "key": "databaseId", "label": "ID base", "col": { "xs": 24 } }
      ] },
      "group": "Firestore"
    },
    {
      "key": "firebase_fcm_message_send",
      "name": "firebaseFcmMessageSend",
      "schemaVersion": 2,
      "title": "Envoyer un message",
      "subtitle": "Cloud Messaging",
      "icon": "fa-solid fa-bell",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["notification", "fcm"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_message" }],
      "authorize_catch_error": true,
      "description": "Envoie un message Firebase Cloud Messaging HTTP v1.",
      "args": { "fields": [
        { "type": "text", "key": "projectId", "label": "ID projet", "description": "Optionnel si défini dans les identifiants.", "col": { "xs": 24 } },
        { "type": "select", "key": "targetType", "label": "Type de cible", "default": "token", "options": ["token", "topic", "condition"], "col": { "xs": 24 } },
        { "type": "text", "key": "target", "label": "Cible", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
        { "type": "text", "key": "title", "label": "Titre", "col": { "xs": 24 } },
        { "type": "textarea", "key": "body", "label": "Corps", "col": { "xs": 24 } },
        { "type": "textarea", "key": "data", "label": "Données JSON", "col": { "xs": 24 } },
        { "type": "textarea", "key": "android", "label": "Options Android JSON", "col": { "xs": 24 } },
        { "type": "textarea", "key": "apns", "label": "Options APNs JSON", "col": { "xs": 24 } },
        { "type": "textarea", "key": "webpush", "label": "Options Webpush JSON", "col": { "xs": 24 } },
        { "type": "checkbox", "key": "validateOnly", "label": "Valider sans envoyer", "col": { "xs": 24 } }
      ] },
      "group": "Cloud Messaging"
    },
    {
      "key": "firebase_rtdb_value_get",
      "name": "firebaseRtdbValueGet",
      "schemaVersion": 2,
      "title": "Lire une valeur",
      "subtitle": "Realtime Database",
      "icon": "fa-solid fa-eye",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["lecture", "database"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_rtdb_value" }],
      "authorize_catch_error": true,
      "description": "Lit une valeur Realtime Database.",
      "args": { "fields": [{ "type": "text", "key": "path", "label": "Chemin", "validators": [{ "type": "required" }], "col": { "xs": 24 } }] },
      "group": "Realtime Database"
    },
    {
      "key": "firebase_rtdb_value_set",
      "name": "firebaseRtdbValueSet",
      "schemaVersion": 2,
      "title": "Écrire une valeur",
      "subtitle": "Realtime Database",
      "icon": "fa-solid fa-floppy-disk",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["écriture", "database"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_rtdb_value" }],
      "authorize_catch_error": true,
      "description": "Remplace une valeur Realtime Database.",
      "args": { "fields": [
        { "type": "text", "key": "path", "label": "Chemin", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
        { "type": "textarea", "key": "value", "label": "Valeur JSON", "validators": [{ "type": "required" }], "col": { "xs": 24 } }
      ] },
      "group": "Realtime Database"
    },
    {
      "key": "firebase_rtdb_value_update",
      "name": "firebaseRtdbValueUpdate",
      "schemaVersion": 2,
      "title": "Modifier une valeur",
      "subtitle": "Realtime Database",
      "icon": "fa-solid fa-pen",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["modification", "database"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_rtdb_value" }],
      "authorize_catch_error": true,
      "description": "Modifie partiellement une valeur Realtime Database.",
      "args": { "fields": [
        { "type": "text", "key": "path", "label": "Chemin", "validators": [{ "type": "required" }], "col": { "xs": 24 } },
        { "type": "textarea", "key": "value", "label": "Valeur JSON", "validators": [{ "type": "required" }], "col": { "xs": 24 } }
      ] },
      "group": "Realtime Database"
    },
    {
      "key": "firebase_rtdb_value_delete",
      "name": "firebaseRtdbValueDelete",
      "schemaVersion": 2,
      "title": "Supprimer une valeur",
      "subtitle": "Realtime Database",
      "icon": "fa-solid fa-trash",
      "type": "function",
      "nodeKind": "function",
      "category": "Firebase",
      "providerKey": "firebase",
      "tags": ["suppression", "database"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:firebase_result" }],
      "authorize_catch_error": true,
      "description": "Supprime une valeur Realtime Database.",
      "args": { "fields": [{ "type": "text", "key": "path", "label": "Chemin", "validators": [{ "type": "required" }], "col": { "xs": 24 } }] },
      "group": "Realtime Database"
    }
  ]
}
