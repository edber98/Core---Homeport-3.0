{
  "providers": [
    {
      "key": "openai",
      "name": "OpenAI",
      "title": "OpenAI",
      "iconClass": "fa-brands fa-openai",
      "color": "#10A37F",
      "tags": ["ai", "llm"],
      "categories": ["AI"],
      "hasCredentials": true,
      "credentialsForm": {
        "title": "Identifiants OpenAI",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "apiKey", "label": "API Key", "col": { "xs": 24 }, "secret": true, "validators": [{"type":"required"}] },
          { "type": "text", "key": "baseUrl", "label": "Base URL (optionnel)", "col": { "xs": 24 } },
          { "type": "text", "key": "organization", "label": "Organization (optionnel)", "col": { "xs": 24 } },
          { "type": "text", "key": "defaultModel", "label": "Modèle par défaut", "col": { "xs": 24 }, "default": "gpt-4o-mini" }
        ]
      }
    }
  ],
  "nodeTemplates": [
    {
      "key": "openai_chat_completion",
      "name": "openaiChatCompletion",
      "schemaVersion": 2,
      "title": "Chat Completion",
      "type": "function",
      "nodeKind": "function",
      "category": "AI",
      "providerKey": "openai",
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload" }],
      "description": "Générer une complétion de chat (messages System/User)",
      "args": {
        "title": "Chat Completion",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "model", "label": "Modèle", "col": { "xs": 24 }, "default": "gpt-4o-mini" },
          { "type": "textarea", "key": "system", "label": "Système", "col": { "xs": 24 } },
          { "type": "textarea", "key": "prompt", "label": "Prompt (User)", "col": { "xs": 24 }, "validators": [{"type":"required"}] },
          { "type": "number", "key": "temperature", "label": "Température", "col": { "xs": 24 }, "default": 0.7 },
          { "type": "number", "key": "maxTokens", "label": "Max tokens", "col": { "xs": 24 } }
        ]
      }
    },
    {
      "key": "openai_memory_static",
      "name": "openaiMemoryStatic",
      "schemaVersion": 2,
      "title": "Memory (Static)",
      "type": "memory",
      "nodeKind": "memory",
      "category": "AI",
      "providerKey": "openai",
      "outputHandles": [ { "id": "memory", "name": "Memory", "type": "ai_memory" } ],
      "description": "Définir une mémoire statique (texte)",
      "args": {
        "title": "Memory (Static)",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "textarea", "key": "text", "label": "Texte de mémoire", "col": { "xs": 24 }, "validators": [ { "type": "required" } ] }
        ]
      }
    },
    {
      "key": "openai_memory_merge",
      "name": "openaiMemoryMerge",
      "schemaVersion": 2,
      "title": "Memory (Merge)",
      "type": "memory",
      "nodeKind": "memory",
      "category": "AI",
      "providerKey": "openai",
      "inputHandles": [ { "id": "in", "name": "Memory", "type": "ai_memory", "accepts": ["ai_memory"] } ],
      "outputHandles": [ { "id": "memory", "name": "Memory", "type": "ai_memory" } ],
      "description": "Fusionner ou relayer des mémoires AI",
      "args": {
        "title": "Memory Merge",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "checkbox", "key": "dedupe", "label": "Supprimer doublons", "col": { "xs": 24 }, "default": true }
        ]
      }
    },
    {
      "key": "openai_tool_define",
      "name": "openaiToolDefine",
      "schemaVersion": 2,
      "title": "Tool (LangChain)",
      "type": "tool_ai",
      "nodeKind": "tool_ai",
      "category": "AI",
      "providerKey": "openai",
      "outputHandles": [ { "id": "tool", "name": "Tool", "type": "ai_tool" } ],
      "description": "Définir un outil LangChain (nom, description, schéma)",
      "args": {
        "title": "Tool (LangChain)",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "name", "label": "Nom de l'outil", "col": { "xs": 24 }, "validators": [ { "type": "required" } ] },
          { "type": "textarea", "key": "description", "label": "Description", "col": { "xs": 24 } },
          { "type": "textarea", "key": "parameters", "label": "Paramètres (JSON Schema)", "col": { "xs": 24 }, "default": "{}" }
        ]
      }
    },
    {
      "key": "openai_embeddings",
      "name": "openaiEmbeddings",
      "schemaVersion": 2,
      "title": "Embeddings",
      "type": "function",
      "nodeKind": "function",
      "category": "AI",
      "providerKey": "openai",
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "ai_vector" }],
      "description": "Générer des vecteurs d’embedding",
      "args": {
        "title": "Embeddings",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "model", "label": "Modèle", "col": { "xs": 24 }, "default": "text-embedding-3-small" },
          { "type": "textarea", "key": "input", "label": "Texte (ou JSON array)", "col": { "xs": 24 }, "validators": [{"type":"required"}] }
        ]
      }
    },
    {
      "key": "openai_image_generate",
      "name": "openaiImageGenerate",
      "schemaVersion": 2,
      "title": "Image Generate",
      "type": "function",
      "nodeKind": "function",
      "category": "AI",
      "providerKey": "openai",
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "ai_image" }],
      "description": "Générer une image à partir d’un prompt",
      "args": {
        "title": "Image Generate",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "model", "label": "Modèle", "col": { "xs": 24 }, "default": "gpt-image-1" },
          { "type": "textarea", "key": "prompt", "label": "Prompt", "col": { "xs": 24 }, "validators": [{"type":"required"}] },
          { "type": "select", "key": "size", "label": "Taille", "col": { "xs": 24 }, "options": [
            { "label": "256x256", "value": "256x256" },
            { "label": "512x512", "value": "512x512" },
            { "label": "1024x1024", "value": "1024x1024" }
          ], "default": "1024x1024" }
        ]
      }
    }
    ,
    {
      "key": "openai_memory_embed",
      "name": "openaiMemoryEmbed",
      "schemaVersion": 2,
      "title": "Memory (Embeddings)",
      "type": "memory",
      "nodeKind": "memory",
      "category": "AI",
      "providerKey": "openai",
      "inputHandles": [
        { "id": "in", "name": "Text", "type": "text", "accepts": ["text"] }
      ],
      "outputHandles": [
        { "id": "memory", "name": "Memory", "type": "ai_memory" }
      ],
      "description": "Indexer un texte en vecteurs (embeddings)",
      "args": {
        "title": "Memory Embeddings",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "textarea", "key": "text", "label": "Texte (si non fourni en entrée)", "col": { "xs": 24 } },
          { "type": "text", "key": "model", "label": "Modèle d'embeddings", "col": { "xs": 24 }, "default": "text-embedding-3-small" }
        ]
      }
    }
    ,
    {
      "key": "openai_agent",
      "name": "openaiAgent",
      "schemaVersion": 2,
      "title": "Agent OpenAI",
      "type": "agent",
      "nodeKind": "agent",
      "category": "AI",
      "providerKey": "openai",
      "inputHandles": [
        { "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }
      ],
      "outputHandles": [
        { "id": "ok", "name": "Success", "type": "payload" }
      ],
      "linkedHandles": [
        { "id": "tools", "name": "Tools", "type": "ai_tool", "multiple": true, "accepts": ["ai_tool"] },
        { "id": "memory", "name": "Memory", "type": "ai_memory", "multiple": true, "accepts": ["ai_memory"] }
      ],
      "description": "Agent OpenAI consommant Memory/Tools",
      "args": {
        "title": "Agent OpenAI",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "model", "label": "Modèle", "col": { "xs": 24 }, "default": "gpt-4o-mini" },
          { "type": "textarea", "key": "system", "label": "Système", "col": { "xs": 24 } },
          { "type": "textarea", "key": "prompt", "label": "Prompt", "col": { "xs": 24 }, "validators": [{"type":"required"}] },
          { "type": "number", "key": "temperature", "label": "Température", "col": { "xs": 24 }, "default": 0.7 }
        ]
      }
    }
  ]
}
