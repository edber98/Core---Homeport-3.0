{
  "repo": {
    "name": "se-ranking",
    "type": "local",
    "label": "SE Ranking"
  },
  "variables": {
    "se_ranking_report": {
      "title": "Rapport SE Ranking",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "totalCount", "label": "Nombre total", "description": "Nombre de lignes.", "col": { "xs": 24 } },
        { "type": "textarea", "key": "raw", "label": "Réponse brute", "description": "Réponse JSON brute.", "col": { "xs": 24 } },
        { "type": "section", "title": "Lignes", "description": "Lignes du rapport.", "mode": "array", "key": "rows", "array": { "initialItems": 0, "minItems": 0 }, "fields": [
          { "type": "textarea", "key": "json", "label": "JSON", "description": "Ligne brute au format JSON.", "col": { "xs": 24 } }
        ], "col": { "xs": 24 } }
      ]
    }
  },
  "providers": [
    {
      "key": "se_ranking",
      "name": "SE Ranking",
      "hasCredentials": true,
