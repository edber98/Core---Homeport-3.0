      "nodeKind": "function",
      "category": "Home Assistant",
      "providerKey": "home_assistant",
      "tags": ["lecture", "états"],
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
