      "authorize_catch_error": true,
      "description": "Vérifie que l'API Home Assistant répond.",
      "args": { "title": "Tester l'API", "ui": { "layout": "vertical", "labelsOnTop": true }, "fields": [], "displayTitle": false, "displayDescription": false },
      "group": "Connexion"
    },
