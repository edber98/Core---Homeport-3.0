  "providers": [
    {
      "key": "home_assistant",
      "name": "Home Assistant",
      "title": "Home Assistant",
      "iconClass": "fa-solid fa-house-signal",
      "iconUrl": "https://cdn.simpleicons.org/homeassistant",
      "color": "#d5f3ff",
      "tags": ["domotique", "iot", "automation"],
      "categories": ["Automatisation"],
      "hasCredentials": true,
      "credentialsForm": {
        "title": "Identifiants Home Assistant",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          {
            "type": "text",
            "key": "baseUrl",
            "label": "URL de l'instance",
            "description": "URL de Home Assistant, par exemple http://homeassistant.local:8123.",
            "default": "http://homeassistant.local:8123",
            "col": { "xs": 24 },
            "validators": [{ "type": "required" }]
          },
          {
            "type": "text",
            "key": "accessToken",
            "label": "Jeton d'accès longue durée",
            "description": "Jeton Bearer créé dans le profil Home Assistant.",
            "col": { "xs": 24 },
            "secret": true,
            "validators": [{ "type": "required" }]
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      }
    }
  ],
  "nodeTemplates": [
    {
      "key": "home_assistant_api_status",
