          "key": "states",
          "array": { "initialItems": 0, "minItems": 0 },
          "fields": [
            { "type": "text", "key": "entity_id", "label": "ID entité", "col": { "xs": 24 } },
            { "type": "text", "key": "state", "label": "État", "col": { "xs": 24 } },
            { "type": "date", "key": "last_changed", "label": "Dernier changement", "col": { "xs": 24 } },
            { "type": "date", "key": "last_updated", "label": "Dernière mise à jour", "col": { "xs": 24 } },
            { "type": "json", "key": "attributes", "label": "Attributs", "col": { "xs": 24 } }
          ],
          "col": { "xs": 24 }
