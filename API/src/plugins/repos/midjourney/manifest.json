            },
            "secret": true,
            "validators": [
              {
                "type": "required"
              }
            ]
          },
          {
            "type": "text",
            "key": "baseUrl",
            "label": "URL de base API",
            "description": "URL de base du provider Midjourney API.",
            "col": {
              "xs": 24
            },
            "default": "https://api.midjourney-api.com"
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      }
    }
