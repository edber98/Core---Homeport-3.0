        "title": "Soumettre un job Midjourney",
        "ui": {
          "layout": "vertical",
          "labelsOnTop": true
        },
        "fields": [
          {
            "type": "textarea",
            "key": "prompt",
            "label": "Prompt",
            "description": "Prompt image Midjourney (ex: style, ratio, paramètres).",
            "col": {
              "xs": 24
            },
            "validators": [
              {
                "type": "required"
              }
            ]
          },
          {
            "type": "select",
            "key": "mode",
            "label": "Mode",
            "description": "Mode de génération Midjourney.",
            "col": {
              "xs": 24
            },
            "default": "fast",
            "options": [
              {
                "label": "Rapide",
                "value": "fast"
              },
              {
                "label": "Détendu",
                "value": "relaxed"
              }
            ]
          },
          {
            "type": "text",
            "key": "hookUrl",
            "label": "URL webhook",
            "description": "URL appelée lorsque la tâche est terminée (optionnel).",
            "col": {
              "xs": 24
            }
          },
          {
            "type": "number",
            "key": "timeout",
            "label": "Timeout (secondes)",
            "description": "Délai max du job (300 à 1200, défaut 600).",
            "col": {
              "xs": 24
            },
            "default": 600
          },
          {
            "type": "json",
            "key": "extraBody",
            "label": "Payload JSON additionnel",
            "description": "Fusionné au body final pour options avancées non exposées.",
            "col": {
              "xs": 24
            }
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "group": "Génération"
    },
