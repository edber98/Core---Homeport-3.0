{
  "repo": {
    "name": "semrush",
    "type": "local",
    "label": "Semrush"
  },
  "variables": {
    "semrush_report": {
      "title": "Rapport Semrush",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "totalCount", "label": "Nombre total", "description": "Nombre de lignes.", "col": { "xs": 24 } },
        { "type": "textarea", "key": "raw", "label": "CSV brut", "description": "Réponse CSV brute.", "col": { "xs": 24 } },
        { "type": "section", "title": "Lignes", "description": "Lignes du rapport.", "mode": "array", "key": "rows", "array": { "initialItems": 0, "minItems": 0 }, "fields": [
          { "type": "text", "key": "Ph", "label": "Mot-clé", "description": "Phrase ou mot-clé.", "col": { "xs": 24 } },
          { "type": "text", "key": "Dn", "label": "Domaine", "description": "Domaine.", "col": { "xs": 24 } },
          { "type": "text", "key": "Po", "label": "Position", "description": "Position.", "col": { "xs": 24 } },
          { "type": "text", "key": "Nq", "label": "Volume", "description": "Volume de recherche.", "col": { "xs": 24 } },
          { "type": "text", "key": "Tr", "label": "Trafic", "description": "Trafic estimé.", "col": { "xs": 24 } },
          { "type": "text", "key": "Kd", "label": "Difficulté", "description": "Difficulté du mot-clé.", "col": { "xs": 24 } }
        ], "col": { "xs": 24 } }
      ]
    }
  },
  "providers": [
    {
      "key": "semrush",
      "name": "Semrush",
      "hasCredentials": true,
      "credentialsForm": {
        "fields": [
          { "type": "password", "key": "apiKey", "label": "Clé API", "description": "Clé API Semrush.", "col": { "xs": 24 } }
        ]
      }
    }
  ],
