          { "type": "number", "key": "focusLon", "label": "Longitude de biais", "col": { "xs": 12 } },
          { "type": "text", "key": "country", "label": "Pays", "description": "Code pays ISO alpha-3, par exemple GBR ou USA.", "col": { "xs": 12 } },
          { "type": "text", "key": "placeTypes", "label": "Types de lieux", "description": "Liste acceptée par Footstep, séparée par des virgules.", "col": { "xs": 24 } }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "group": "Géocodage"
    },
