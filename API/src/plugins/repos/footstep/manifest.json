      "title": "Altitudes Footstep",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "json", "key": "elevations", "label": "Altitudes", "col": { "xs": 24 } },
        { "type": "json", "key": "summary", "label": "Synthèse", "col": { "xs": 24 } },
        { "type": "json", "key": "raw", "label": "Réponse brute", "col": { "xs": 24 } }
      ]
    }
