    "footstep_batch_results": {
      "title": "Résultats groupés Footstep",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "number", "key": "totalCount", "label": "Nombre total", "col": { "xs": 24 } },
        { "type": "json", "key": "results", "label": "Résultats", "col": { "xs": 24 } },
        { "type": "json", "key": "raw", "label": "Réponse brute", "col": { "xs": 24 } }
      ]
    },
    "footstep_parse_results": {
      "title": "Adresses analysées Footstep",
