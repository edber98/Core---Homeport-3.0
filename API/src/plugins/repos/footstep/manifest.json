        { "type": "json", "key": "raw", "label": "Réponse brute", "col": { "xs": 24 } }
      ]
    },
    "footstep_matrix_result": {
      "title": "Matrice Footstep",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "json", "key": "matrix", "label": "Matrice", "col": { "xs": 24 } },
        { "type": "json", "key": "sources", "label": "Sources", "col": { "xs": 24 } },
        { "type": "json", "key": "targets", "label": "Destinations", "col": { "xs": 24 } },
        { "type": "json", "key": "raw", "label": "Réponse brute", "col": { "xs": 24 } }
      ]
