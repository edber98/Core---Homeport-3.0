  "providers": [
    {
      "key": "footstep",
      "name": "Footstep",
      "title": "Footstep",
      "iconClass": "fa-solid fa-map-location-dot",
      "iconUrl": "https://www.footstep.ai/favicon.ico",
      "color": "#16a34a",
      "tags": ["footstep", "géocodage", "itinéraire"],
      "categories": ["Cartographie"],
