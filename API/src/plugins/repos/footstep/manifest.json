            "secret": true,
            "validators": [{ "type": "required" }]
          },
          {
            "type": "text",
            "key": "baseUrl",
            "label": "URL de base",
            "description": "URL de l'API Footstep.",
            "default": "https://api.footstep.ai",
            "col": { "xs": 24 }
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      }
    }
  ],
  "nodeTemplates": [
    {
      "key": "footstep_geocoding_search",
