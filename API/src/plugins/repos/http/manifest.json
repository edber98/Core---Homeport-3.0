{
  "repo": {
    "name": "http",
    "type": "local",
    "label": "HTTP"
  },
  "variables": {
    "http_incoming": {
      "title": "Requête entrante",
      "ui": {
        "layout": "vertical",
        "labelsOnTop": true
      },
      "fields": [
        {
          "type": "text",
          "key": "method",
          "label": "Méthode",
          "description": "Méthode HTTP (GET, POST, ...).",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "text",
          "key": "path",
          "label": "Chemin",
          "description": "Chemin d’accès de la requête.",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "textarea",
          "key": "headers",
          "label": "Headers (JSON)",
          "description": "En-têtes HTTP au format JSON.",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "textarea",
          "key": "query",
          "label": "Query (JSON)",
          "description": "Paramètres de requête au format JSON.",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "textarea",
          "key": "body",
          "label": "Body (JSON)",
          "description": "Corps de la requête au format JSON.",
          "col": {
            "xs": 24
          }
        }
      ]
    },
    "http_response": {
      "title": "Réponse HTTP",
      "ui": {
        "layout": "vertical",
        "labelsOnTop": true
      },
      "fields": [
        {
          "type": "number",
          "key": "status",
          "label": "Status",
          "description": "Code de statut HTTP (ex.: 200, 404).",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "textarea",
          "key": "headers",
          "label": "Headers (JSON)",
          "description": "En-têtes de la réponse au format JSON.",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "textarea",
          "key": "body",
          "label": "Body (JSON)",
          "description": "Corps de la réponse au format JSON.",
          "col": {
            "xs": 24
          }
        }
      ]
    }
  },
  "providers": [
    {
      "key": "http",
      "name": "HTTP",
      "title": "HTTP",
      "iconClass": "fa-solid fa-globe",
      "color": "#0ea5e9",
      "tags": [
        "http"
      ],
      "hasCredentials": false
    }
  ],
  "nodeTemplates": [
    {
      "key": "core_webhook",
      "name": "httpTrigger",
      "schemaVersion": 2,
      "title": "Déclencheur HTTP",
      "subtitle": "Trigger entrant",
      "type": "event",
      "category": "HTTP",
      "providerKey": "http",
      "description": "Déclenche le flow via une requête HTTP entrante. URL et auth générées par Kinn.",
      "output_schema_field": "payload_schema",
      "outputHandles": [
        {
          "id": "ok",
          "name": "Success",
          "type": "payload",
          "schema": "$var:http_incoming"
        }
      ],
      "args": {
        "title": "Déclencheur HTTP",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          {
            "type": "resolver",
            "key": "webhook_url",
            "label": "URL du déclencheur",
            "description": "URLs publiques où l'extérieur doit envoyer la requête. Persistantes, ne changent que sur clic 'Régénérer'.",
            "resolver": "core_webhook_url",
            "variants": [
              { "id": "production", "label": "Production" },
              { "id": "test",       "label": "Test" }
            ],
            "actions": [
              { "id": "rotate_url", "label": "Régénérer l'URL", "confirm": true, "requiresAdmin": true }
            ],
            "copyable": true,
            "col": { "xs": 24 }
          },
          {
            "type": "select",
            "key": "method",
            "label": "Méthode HTTP attendue",
            "col": { "xs": 24 },
            "options": [
              { "label": "GET", "value": "GET" },
              { "label": "POST", "value": "POST" },
              { "label": "PUT", "value": "PUT" },
              { "label": "PATCH", "value": "PATCH" },
              { "label": "DELETE", "value": "DELETE" }
            ],
            "default": "POST"
          },
          {
            "type": "select",
            "key": "auth_mode",
            "label": "Mode d'authentification",
            "description": "Comment l'extérieur doit prouver son identité pour appeler ce déclencheur.",
            "col": { "xs": 24 },
            "options": [
              { "label": "Public (aucune auth)", "value": "public" },
              { "label": "Bearer token",          "value": "token" },
              { "label": "HTTP Basic (user/pwd)", "value": "basic" },
              { "label": "Signature HMAC",        "value": "hmac" },
              { "label": "PAT Kinn (du workspace)", "value": "pat" }
            ],
            "default": "token"
          },
          {
            "type": "resolver",
            "key": "auth_token",
            "label": "Bearer token",
            "description": "À placer dans 'Authorization: Bearer <token>'.",
            "resolver": "core_webhook_token",
            "secret": true,
            "copyable": true,
            "actions": [
              { "id": "rotate_secret", "label": "Régénérer le token", "confirm": true, "requiresAdmin": true }
            ],
            "visibleIf": { "==": [{ "var": "auth_mode" }, "token"] },
            "col": { "xs": 24 }
          },
          {
            "type": "text",
            "key": "auth_username",
            "label": "Nom d'utilisateur (HTTP Basic)",
            "visibleIf": { "==": [{ "var": "auth_mode" }, "basic"] },
            "requiredIf": { "==": [{ "var": "auth_mode" }, "basic"] },
            "col": { "xs": 24 }
          },
          {
            "type": "resolver",
            "key": "auth_password",
            "label": "Mot de passe (HTTP Basic)",
            "resolver": "core_webhook_password",
            "secret": true,
            "copyable": true,
            "actions": [
              { "id": "rotate_secret", "label": "Régénérer le mot de passe", "confirm": true, "requiresAdmin": true }
            ],
            "visibleIf": { "==": [{ "var": "auth_mode" }, "basic"] },
            "col": { "xs": 24 }
          },
          {
            "type": "select",
            "key": "hmac_algo",
            "label": "Algorithme HMAC",
            "options": [
              { "label": "SHA-256", "value": "sha256" },
              { "label": "SHA-1",   "value": "sha1" },
              { "label": "SHA-512", "value": "sha512" }
            ],
            "default": "sha256",
            "visibleIf": { "==": [{ "var": "auth_mode" }, "hmac"] },
            "col": { "xs": 24 }
          },
          {
            "type": "resolver",
            "key": "auth_secret",
            "label": "Secret HMAC",
            "description": "Signe le body : header 'X-Kinn-Signature: <algo>=<hex>'.",
            "resolver": "core_webhook_hmac_secret",
            "secret": true,
            "copyable": true,
            "actions": [
              { "id": "rotate_secret", "label": "Régénérer le secret", "confirm": true, "requiresAdmin": true }
            ],
            "visibleIf": { "==": [{ "var": "auth_mode" }, "hmac"] },
            "col": { "xs": 24 }
          },
          {
            "type": "schema_builder",
            "key": "payload_schema",
            "label": "Schéma du payload reçu",
            "description": "Décrit la structure attendue du body. Définit l'output disponible pour les nodes en aval.",
            "col": { "xs": 24 }
          },
          {
            "type": "checkbox",
            "key": "cors",
            "label": "Autoriser CORS",
            "description": "Active l'en-tête Access-Control-Allow-Origin: *.",
            "col": { "xs": 24 },
            "default": true
          },
          {
            "type": "number",
            "key": "respondStatus",
            "label": "Code HTTP de réponse",
            "col": { "xs": 24 },
            "default": 200
          },
          {
            "type": "textarea",
            "key": "respondBody",
            "label": "Corps de réponse (JSON/texte)",
            "description": "Vide = JSON par défaut { ok: true, flowId, triggered: true }.",
            "col": { "xs": 24 },
            "default": ""
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "group": "Webhooks",
      "tags": ["http", "trigger"]
    },
    {
      "key": "http",
      "name": "httpRequest",
      "schemaVersion": 2,
      "title": "HTTP Request",
      "subtitle": "Call API",
      "type": "function",
      "category": "HTTP",
      "providerKey": "http",
      "description": "Effectuer un appel HTTP",
      "inputHandles": [
        {
          "id": "in",
          "name": "In",
          "type": "payload",
          "accepts": [
            "payload",
            "any"
          ]
        }
      ],
      "outputHandles": [
        {
          "id": "ok",
          "name": "Success",
          "type": "payload",
          "schema": "$var:http_response"
        }
      ],
      "args": {
        "title": "HTTP",
        "ui": {
          "layout": "vertical",
          "labelsOnTop": true
        },
        "fields": [
          {
            "type": "select",
            "key": "method",
            "label": "Méthode",
            "description": "Méthode HTTP.",
            "options": [
              {
                "label": "GET",
                "value": "GET"
              },
              {
                "label": "POST",
                "value": "POST"
              },
              {
                "label": "PUT",
                "value": "PUT"
              },
              {
                "label": "PATCH",
                "value": "PATCH"
              },
              {
                "label": "DELETE",
                "value": "DELETE"
              }
            ],
            "col": {
              "xs": 24
            },
            "default": "GET",
            "expression": {
              "allow": true,
              "defaultMode": "val"
            }
          },
          {
            "type": "text",
            "key": "url",
            "label": "URL",
            "description": "Adresse de la requête.",
            "col": {
              "xs": 24
            },
            "validators": [
              {
                "type": "required"
              }
            ]
          },
          {
            "type": "textarea",
            "key": "headers",
            "label": "Headers (JSON)",
            "description": "En-têtes au format JSON.",
            "col": {
              "xs": 24
            },
            "default": "{}"
          },
          {
            "type": "textarea",
            "key": "body",
            "label": "Body (JSON)",
            "description": "Corps de la requête au format JSON.",
            "col": {
              "xs": 24
            },
            "default": "{}",
            "visibleIf": {
              "method": [
                "POST",
                "PUT",
                "PATCH"
              ]
            }
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "group": "Call API",
      "tags": [
        "http"
      ],
      "risk": "elevated",
      "riskReason": "Appel HTTP arbitraire (URL/méthode libre)"
    }
  ]
}
