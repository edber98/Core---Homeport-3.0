            "label": "Cible"
          },
          {
            "type": "select",
            "key": "mode",
            "label": "Mode",
            "default": "domain",
            "options": [
              {
                "label": "Domain",
                "value": "domain"
              },
              {
                "label": "Exact",
                "value": "exact"
              },
              {
                "label": "Prefix",
                "value": "prefix"
              },
              {
                "label": "Subdomains",
                "value": "subdomains"
              }
            ]
          }
        ]
      },
      "outputHandles": [
        {
          "id": "ok",
          "type": "payload",
          "schema": "$var:ahrefs_metric"
        },
        {
          "id": "err",
          "type": "error"
        }
      ]
