{
  "repo": {
    "name": "ahrefs",
    "type": "local",
    "label": "Ahrefs"
  },
  "variables": {
    "ahrefs_metric": {
      "title": "Métrique Ahrefs",
      "ui": {
        "layout": "vertical",
        "labelsOnTop": true
      },
      "fields": [
        {
          "type": "text",
          "key": "target",
          "label": "Cible",
          "description": "Domaine, URL ou workspace.",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "text",
          "key": "metric",
          "label": "Métrique",
          "description": "Nom de la métrique.",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "text",
          "key": "value",
          "label": "Valeur",
          "description": "Valeur principale.",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "textarea",
          "key": "raw",
          "label": "Réponse brute",
          "description": "Réponse JSON brute.",
          "col": {
            "xs": 24
          }
        }
      ]
    },
    "ahrefs_report": {
      "title": "Rapport Ahrefs",
      "ui": {
        "layout": "vertical",
        "labelsOnTop": true
      },
      "fields": [
        {
          "type": "text",
          "key": "totalCount",
          "label": "Nombre total",
          "description": "Nombre de lignes.",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "textarea",
          "key": "raw",
          "label": "Réponse brute",
          "description": "Réponse JSON brute.",
          "col": {
            "xs": 24
          }
        },
        {
          "type": "section",
          "title": "Lignes",
          "description": "Lignes du rapport.",
          "mode": "array",
          "key": "rows",
          "array": {
            "initialItems": 0,
            "minItems": 0
          },
          "fields": [
            {
              "type": "textarea",
              "key": "json",
              "label": "JSON",
              "description": "Ligne brute au format JSON.",
              "col": {
                "xs": 24
              }
            }
          ],
          "col": {
            "xs": 24
          }
        }
      ]
    }
  },
  "providers": [
    {
      "key": "ahrefs",
      "name": "Ahrefs",
      "title": "Ahrefs",
      "iconClass": "fa-solid fa-chart-line",
      "iconUrl": "https://cdn.jsdelivr.net/gh/glincker/thesvg@main/public/icons/ahrefs/default.svg",
      "color": "#ffe7cc",
      "hasCredentials": true,
      "credentialsForm": {
        "fields": [
          {
            "type": "password",
            "key": "apiKey",
            "label": "Clé API",
            "description": "Clé API v3 Ahrefs.",
            "col": {
              "xs": 24
            }
          }
        ]
      }
    }
  ],
  "nodeTemplates": [
