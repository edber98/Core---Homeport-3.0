        { "type": "text", "key": "id", "label": "ID", "description": "Identifiant unique de la demande.", "col": { "xs": 24 } },
        { "type": "text", "key": "name", "label": "Nom", "description": "Nom de la demande.", "col": { "xs": 24 } },
        { "type": "text", "key": "status", "label": "Statut", "description": "Statut (draft, ongoing, done, declined, expired, canceled).", "col": { "xs": 24 } },
        { "type": "text", "key": "delivery_mode", "label": "Mode de livraison", "description": "Mode de livraison (email, none).", "col": { "xs": 24 } },
        { "type": "text", "key": "created_at", "label": "Date de création", "description": "Date de création (ISO 8601).", "col": { "xs": 24 } },
        { "type": "text", "key": "expiration_date", "label": "Date d'expiration", "description": "Date d'expiration.", "col": { "xs": 24 } },
        { "type": "text", "key": "external_id", "label": "ID externe", "description": "Identifiant externe personnalisé.", "col": { "xs": 24 } },
        { "type": "checkbox", "key": "ordered_signers", "label": "Signataires ordonnés", "description": "Signataires dans un ordre précis.", "col": { "xs": 24 } }
