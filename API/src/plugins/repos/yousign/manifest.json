        {
          "type": "section", "title": "Documents", "key": "documents", "mode": "array",
          "array": { "initialItems": 0, "minItems": 0 },
          "fields": [
            { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
            { "type": "text", "key": "nature", "label": "Nature", "col": { "xs": 24 } }
          ],
          "col": { "xs": 24 }
        }
      ]
    },
    "ys_signature_requests": {
      "title": "Demandes de signature",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        {
          "type": "section", "title": "Demandes", "key": "requests", "mode": "array",
          "array": { "initialItems": 0, "minItems": 0 },
          "fields": [
            { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
            { "type": "text", "key": "name", "label": "Nom", "col": { "xs": 24 } },
            { "type": "text", "key": "status", "label": "Statut", "col": { "xs": 24 } },
            { "type": "text", "key": "delivery_mode", "label": "Mode de livraison", "col": { "xs": 24 } },
            { "type": "text", "key": "created_at", "label": "Date de création", "col": { "xs": 24 } }
          ],
          "col": { "xs": 24 }
        },
        { "type": "text", "key": "totalCount", "label": "Total", "col": { "xs": 24 } }
      ]
    },
    "ys_document": {
      "title": "Document",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
        { "type": "text", "key": "filename", "label": "Nom du fichier", "col": { "xs": 24 } },
        { "type": "text", "key": "nature", "label": "Nature", "description": "signable_document ou attachment.", "col": { "xs": 24 } },
        { "type": "text", "key": "content_type", "label": "Type de contenu", "col": { "xs": 24 } },
        { "type": "number", "key": "total_pages", "label": "Nombre de pages", "col": { "xs": 24 } },
        { "type": "text", "key": "created_at", "label": "Date de création", "col": { "xs": 24 } }
      ]
    },
    "ys_documents": {
      "title": "Documents",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        {
          "type": "section", "title": "Documents", "key": "documents", "mode": "array",
          "array": { "initialItems": 0, "minItems": 0 },
          "fields": [
            { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
            { "type": "text", "key": "filename", "label": "Nom du fichier", "col": { "xs": 24 } },
            { "type": "text", "key": "nature", "label": "Nature", "col": { "xs": 24 } },
            { "type": "number", "key": "total_pages", "label": "Pages", "col": { "xs": 24 } }
