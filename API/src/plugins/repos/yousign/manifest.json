  "providers": [
    {
      "key": "yousign",
      "name": "Yousign",
      "title": "Yousign",
      "iconClass": "fa-solid fa-file-signature",
      "iconUrl": "https://cdn.simpleicons.org/yousign",
      "color": "#0B68FF",
      "tags": ["signature", "esignature", "document"],
      "categories": ["Signature électronique"],
      "hasCredentials": true,
      "credentialsForm": {
        "title": "Identifiants Yousign",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          {
            "type": "text",
            "key": "apiKey",
            "label": "Clé API",
            "description": "Clé API Bearer de votre compte Yousign.",
            "col": { "xs": 24 },
            "secret": true,
            "validators": [{ "type": "required" }]
          },
          {
            "type": "select",
            "key": "environment",
            "label": "Environnement",
            "description": "Sandbox pour les tests, Production pour les signatures réelles.",
            "col": { "xs": 24 },
            "default": "sandbox",
            "options": [
              { "label": "Sandbox", "value": "sandbox" },
              { "label": "Production", "value": "production" }
            ]
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      }
    }
  ],
  "nodeTemplates": [
    {
      "key": "yousign_signature_request_create",
      "name": "yousignSignatureRequestCreate",
      "schemaVersion": 2,
      "title": "Créer une demande de signature",
      "subtitle": "Signature",
      "icon": "fa-solid fa-file-circle-plus",
      "type": "function",
      "nodeKind": "function",
      "category": "Signature électronique",
      "providerKey": "yousign",
      "description": "Créer une nouvelle demande de signature Yousign",
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [
        { "id": "ok", "name": "Success", "type": "payload", "schema": "$var:ys_signature_request" },
        { "id": "err", "name": "Error", "type": "error" }
      ],
      "authorize_catch_error": true,
      "args": {
        "title": "Demande de signature",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "name", "label": "Nom", "description": "Nom de la demande de signature.", "col": { "xs": 24 }, "validators": [{ "type": "required" }] },
          { "type": "select", "key": "delivery_mode", "label": "Mode de livraison", "description": "Mode d'envoi aux signataires.", "col": { "xs": 24 }, "default": "email", "options": [{ "label": "E-mail", "value": "email" }, { "label": "Aucun (lien API)", "value": "none" }] },
          { "type": "text", "key": "expiration_date", "label": "Date d'expiration", "description": "Date limite (ISO 8601, ex: 2025-12-31).", "col": { "xs": 24 } },
          { "type": "checkbox", "key": "ordered_signers", "label": "Signataires ordonnés", "description": "Les signataires doivent signer dans l'ordre.", "col": { "xs": 24 }, "default": false },
          { "type": "text", "key": "external_id", "label": "ID externe", "description": "Identifiant personnalisé pour le suivi.", "col": { "xs": 24 } },
          { "type": "text", "key": "custom_experience_id", "label": "ID expérience personnalisée", "description": "ID de l'expérience de signature personnalisée.", "col": { "xs": 24 } },
          { "type": "text", "key": "timezone", "label": "Fuseau horaire", "description": "Ex: Europe/Paris.", "col": { "xs": 24 }, "default": "Europe/Paris" }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "group": "Demandes",
      "tags": ["création", "signature"]
    },
    {
      "key": "yousign_signature_request_get",
      "name": "yousignSignatureRequestGet",
      "schemaVersion": 2,
      "title": "Récupérer une demande de signature",
      "subtitle": "Signature",
      "icon": "fa-solid fa-file-lines",
      "type": "function",
      "nodeKind": "function",
      "category": "Signature électronique",
      "providerKey": "yousign",
      "description": "Récupérer les détails d'une demande de signature",
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [
        { "id": "ok", "name": "Success", "type": "payload", "schema": "$var:ys_signature_request_full" },
        { "id": "err", "name": "Error", "type": "error" }
      ],
      "authorize_catch_error": true,
      "args": {
        "title": "Récupérer une demande",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "signature_request_id", "label": "ID de la demande", "description": "Identifiant UUID de la demande.", "col": { "xs": 24 }, "validators": [{ "type": "required" }] }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "group": "Demandes",
      "tags": ["lecture", "signature"]
    },
    {
      "key": "yousign_signature_requests_list",
      "name": "yousignSignatureRequestsList",
      "schemaVersion": 2,
      "title": "Lister les demandes de signature",
      "subtitle": "Signature",
      "icon": "fa-solid fa-list-check",
      "type": "function",
      "nodeKind": "function",
      "category": "Signature électronique",
      "providerKey": "yousign",
      "description": "Lister les demandes de signature avec filtres",
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [
        { "id": "ok", "name": "Success", "type": "payload", "schema": "$var:ys_signature_requests" },
        { "id": "err", "name": "Error", "type": "error" }
      ],
      "authorize_catch_error": true,
      "args": {
        "title": "Lister les demandes",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "select", "key": "status", "label": "Statut", "description": "Filtrer par statut.", "col": { "xs": 24 }, "options": [{ "label": "Tous", "value": "" }, { "label": "Brouillon", "value": "draft" }, { "label": "En cours", "value": "ongoing" }, { "label": "Terminé", "value": "done" }, { "label": "Refusé", "value": "declined" }, { "label": "Expiré", "value": "expired" }, { "label": "Annulé", "value": "canceled" }] },
          { "type": "number", "key": "limit", "label": "Limite", "description": "Nombre maximum de résultats.", "col": { "xs": 24 }, "default": 100 },
          { "type": "text", "key": "q", "label": "Recherche", "description": "Rechercher par nom.", "col": { "xs": 24 } },
          { "type": "text", "key": "external_id", "label": "ID externe", "description": "Filtrer par ID externe.", "col": { "xs": 24 } }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "group": "Demandes",
      "tags": ["liste", "signature"]
    },
    {
      "key": "yousign_signature_request_activate",
      "name": "yousignSignatureRequestActivate",
      "schemaVersion": 2,
      "title": "Activer une demande de signature",
      "subtitle": "Signature",
      "icon": "fa-solid fa-circle-play",
      "type": "function",
      "nodeKind": "function",
      "category": "Signature électronique",
      "providerKey": "yousign",
      "description": "Activer une demande de signature (envoi aux signataires)",
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [
        { "id": "ok", "name": "Success", "type": "payload", "schema": "$var:ys_signature_request" },
        { "id": "err", "name": "Error", "type": "error" }
      ],
      "authorize_catch_error": true,
      "args": {
        "title": "Activer une demande",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "signature_request_id", "label": "ID de la demande", "col": { "xs": 24 }, "validators": [{ "type": "required" }] }
        ],
        "displayTitle": false,
        "displayDescription": false
      },
      "group": "Demandes",
      "tags": ["activation", "signature"]
    },
    {
      "key": "yousign_signature_request_cancel",
      "name": "yousignSignatureRequestCancel",
      "schemaVersion": 2,
      "title": "Annuler une demande de signature",
      "subtitle": "Signature",
      "icon": "fa-solid fa-circle-xmark",
      "type": "function",
      "nodeKind": "function",
      "category": "Signature électronique",
      "providerKey": "yousign",
      "description": "Annuler une demande de signature en cours",
      "inputHandles": [{ "id": "in", "name": "In", "type": "any", "accepts": ["any", "payload"] }],
      "outputHandles": [
        { "id": "ok", "name": "Success", "type": "payload", "schema": "$var:ys_signature_request" },
        { "id": "err", "name": "Error", "type": "error" }
      ],
      "authorize_catch_error": true,
      "args": {
        "title": "Annuler une demande",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "signature_request_id", "label": "ID de la demande", "col": { "xs": 24 }, "validators": [{ "type": "required" }] },
          { "type": "select", "key": "reason", "label": "Raison", "description": "Raison de l'annulation.", "col": { "xs": 24 }, "options": [{ "label": "Demandé par le contractant", "value": "contractualization_aborted" }, { "label": "Autre", "value": "other" }] },
          { "type": "textarea", "key": "custom_note", "label": "Note personnalisée", "description": "Message optionnel.", "col": { "xs": 24 } }
