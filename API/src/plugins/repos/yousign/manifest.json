{
  "repo": {
    "name": "yousign",
    "type": "local",
    "label": "Yousign"
  },
  "variables": {
    "ys_signature_request": {
      "title": "Demande de signature",
      "ui": { "layout": "vertical", "labelsOnTop": true },
