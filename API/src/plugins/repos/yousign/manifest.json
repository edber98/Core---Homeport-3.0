        { "type": "text", "key": "last_name", "label": "Nom", "col": { "xs": 24 } },
        { "type": "text", "key": "email", "label": "E-mail", "col": { "xs": 24 } },
        { "type": "text", "key": "phone_number", "label": "Téléphone", "col": { "xs": 24 } },
        { "type": "text", "key": "company_name", "label": "Société", "col": { "xs": 24 } },
        { "type": "text", "key": "job_title", "label": "Poste", "col": { "xs": 24 } },
