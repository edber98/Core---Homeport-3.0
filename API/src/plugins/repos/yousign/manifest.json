    "ys_contacts": {
      "title": "Contacts",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        {
          "type": "section", "title": "Contacts", "key": "contacts", "mode": "array",
          "array": { "initialItems": 0, "minItems": 0 },
          "fields": [
            { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
            { "type": "text", "key": "first_name", "label": "Prénom", "col": { "xs": 24 } },
            { "type": "text", "key": "last_name", "label": "Nom", "col": { "xs": 24 } },
            { "type": "text", "key": "email", "label": "E-mail", "col": { "xs": 24 } },
            { "type": "text", "key": "company_name", "label": "Société", "col": { "xs": 24 } }
          ],
          "col": { "xs": 24 }
        },
        { "type": "text", "key": "totalCount", "label": "Total", "col": { "xs": 24 } }
      ]
    },
    "ys_deleted": {
      "title": "Suppression",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "checkbox", "key": "deleted", "label": "Supprimé", "col": { "xs": 24 } },
        { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } }
      ]
    },
    "ys_webhook": {
      "title": "Webhook",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
        { "type": "text", "key": "endpoint", "label": "Endpoint", "col": { "xs": 24 } },
        { "type": "text", "key": "description", "label": "Description", "col": { "xs": 24 } },
        { "type": "checkbox", "key": "enabled", "label": "Activé", "col": { "xs": 24 } },
        { "type": "checkbox", "key": "sandbox", "label": "Sandbox", "col": { "xs": 24 } },
        { "type": "checkbox", "key": "auto_retry", "label": "Auto-retry", "col": { "xs": 24 } },
        { "type": "text", "key": "created_at", "label": "Date de création", "col": { "xs": 24 } }
      ]
    },
    "ys_webhooks": {
      "title": "Webhooks",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        {
          "type": "section", "title": "Webhooks", "key": "webhooks", "mode": "array",
          "array": { "initialItems": 0, "minItems": 0 },
          "fields": [
            { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
            { "type": "text", "key": "endpoint", "label": "Endpoint", "col": { "xs": 24 } },
            { "type": "checkbox", "key": "enabled", "label": "Activé", "col": { "xs": 24 } }
          ],
          "col": { "xs": 24 }
        },
        { "type": "text", "key": "totalCount", "label": "Total", "col": { "xs": 24 } }
      ]
    },
    "ys_webhook_event": {
      "title": "Événement Yousign",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "event_name", "label": "Nom de l'événement", "description": "Type d'événement (ex: signature_request.done)." },
        { "type": "text", "key": "event_time", "label": "Date de l'événement" },
        { "type": "text", "key": "signature_request_id", "label": "ID de la demande" },
