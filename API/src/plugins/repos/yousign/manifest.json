    "ys_signer": {
      "title": "Signataire",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "id", "label": "ID", "col": { "xs": 24 } },
        { "type": "text", "key": "status", "label": "Statut", "description": "initiated, notified, verified, processing, signed, aborted, error.", "col": { "xs": 24 } },
        { "type": "text", "key": "first_name", "label": "Prénom", "col": { "xs": 24 } },
        { "type": "text", "key": "last_name", "label": "Nom", "col": { "xs": 24 } },
        { "type": "text", "key": "email", "label": "E-mail", "col": { "xs": 24 } },
        { "type": "text", "key": "phone_number", "label": "Téléphone", "col": { "xs": 24 } },
        { "type": "text", "key": "signature_level", "label": "Niveau de signature", "col": { "xs": 24 } },
        { "type": "text", "key": "signature_link", "label": "Lien de signature", "col": { "xs": 24 } },
        { "type": "text", "key": "signed_at", "label": "Signé le", "col": { "xs": 24 } },
        { "type": "text", "key": "created_at", "label": "Date de création", "col": { "xs": 24 } }
      ]
    },
    "ys_signers": {
      "title": "Signataires",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
