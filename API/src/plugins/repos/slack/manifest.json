{
  "repo": { "name": "slack", "type": "local", "label": "Slack" },
  "variables": {
    "slack_message": {
      "title": "Message Slack",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "channel", "label": "Canal", "description": "Identifiant du canal (ex.: C12345)", "col": { "xs": 24 } },
        { "type": "text", "key": "ts", "label": "Timestamp", "description": "Horodatage du message (TS Slack).", "col": { "xs": 24 } },
        { "type": "textarea", "key": "text", "label": "Texte", "description": "Contenu textuel du message.", "col": { "xs": 24 } },
        { "type": "textarea", "key": "blocks", "label": "Blocs (JSON)", "description": "Blocs du message au format JSON.", "col": { "xs": 24 } }
      ]
    },
    "slack_file": {
      "title": "Fichier Slack",
      "ui": { "layout": "vertical", "labelsOnTop": true },
      "fields": [
        { "type": "text", "key": "id", "label": "ID", "description": "Identifiant du fichier Slack.", "col": { "xs": 24 } },
        { "type": "text", "key": "name", "label": "Nom", "description": "Nom du fichier.", "col": { "xs": 24 } },
        { "type": "text", "key": "mimetype", "label": "Type", "description": "Type MIME du fichier.", "col": { "xs": 24 } },
        { "type": "number", "key": "size", "label": "Taille (octets)", "description": "Taille du fichier en octets.", "col": { "xs": 24 } },
        { "type": "text", "key": "url_private", "label": "URL privée", "description": "URL privée de téléchargement du fichier.", "col": { "xs": 24 } }
      ]
    }
  },
  "providers": [
    {
      "key": "slack",
      "name": "Slack",
      "title": "Slack",
      "iconClass": "fa-brands fa-slack",
      "color": "#4A154B",
      "tags": ["chat", "collaboration"],
      "categories": ["Communication"],
      "hasCredentials": true,
      "credentialsForm": {
        "title": "Identifiants de l’application Slack",
        "ui": { "layout": "vertical", "labelsOnTop": true },
        "fields": [
          { "type": "text", "key": "botToken", "label": "Jeton bot (xoxb-)", "col": { "xs": 24 }, "secret": true, "validators": [{"type":"required"}] },
          { "type": "text", "key": "signingSecret", "label": "Secret de signature", "col": { "xs": 24 }, "secret": true },
          { "type": "text", "key": "appId", "label": "ID d’app", "col": { "xs": 24 } }
        ]
      }
    }
  ],
  "nodeTemplates": [
    { "key": "slack_post_message", "name": "slackPostMessage", "schemaVersion": 2, "title": "Publier un message", "type": "function", "nodeKind": "function", "category": "Slack", "providerKey": "slack",
      "inputHandles": [{ "id": "in", "name": "In", "type": "payload", "accepts": ["payload","any"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:slack_message" }],
      "description": "Publier un message dans un canal ou DM", "args": { "title": "Publication", "ui": {"layout":"vertical","labelsOnTop": true}, "fields": [
        {"type":"text","key":"channel","label":"Canal/DM","description":"Identifiant du canal ou utilisateur (DM).","col":{"xs":24},"validators":[{"type":"required"}]},
        {"type":"textarea","key":"text","label":"Texte","description":"Contenu textuel du message.","col":{"xs":24}},
        {"type":"textarea","key":"blocks","label":"Blocs (JSON)","description":"Bloc(s) de mise en forme JSON.","col":{"xs":24},"default":"[]"}
      ] } },
    { "key": "slack_reply_in_thread", "name": "slackReplyInThread", "schemaVersion": 2, "title": "Répondre dans un fil", "type": "function", "nodeKind": "function", "category": "Slack", "providerKey": "slack",
      "inputHandles": [{ "id": "in", "name": "In", "type": "payload", "accepts": ["payload","any"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:slack_message" }],
      "description": "Répondre dans un fil", "args": { "title": "Fil", "ui": {"layout":"vertical","labelsOnTop": true}, "fields": [
        {"type":"text","key":"channel","label":"Canal","description":"Identifiant du canal.","col":{"xs":24},"validators":[{"type":"required"}]},
        {"type":"text","key":"threadTs","label":"TS du fil","description":"Horodatage du message parent.","col":{"xs":24},"validators":[{"type":"required"}]},
        {"type":"textarea","key":"text","label":"Texte","description":"Contenu de la réponse.","col":{"xs":24}}
      ] } },
    { "key": "slack_upload_file", "name": "slackUploadFile", "schemaVersion": 2, "title": "Téléverser un fichier", "type": "function", "nodeKind": "function", "category": "Slack", "providerKey": "slack",
      "inputHandles": [{ "id": "in", "name": "In", "type": "payload", "accepts": ["file","payload","any"] }],
      "outputHandles": [{ "id": "ok", "name": "Success", "type": "payload", "schema": "$var:slack_file" }],
      "description": "Téléverser un fichier sur Slack", "args": { "title": "Téléversement", "ui": {"layout":"vertical","labelsOnTop": true}, "fields": [
        {"type":"text","key":"channels","label":"Canaux (séparés par des virgules)","description":"Liste des canaux ciblés.","col":{"xs":24}},
        {"type":"text","key":"filename","label":"Nom de fichier","description":"Nom du fichier à afficher.","col":{"xs":24}},
        {"type":"textarea","key":"content","label":"Contenu (texte)","description":"Contenu texte du fichier.","col":{"xs":24}}
      ] } },
    { "key": "slack_slash_command", "name": "slackSlashCommand", "schemaVersion": 2, "title": "Commande slash", "subtitle": "Déclencheur", "type": "event", "category": "Slack", "providerKey": "slack",
      "description": "Déclenchement sur commande slash", "args": { "title": "Commande slash", "ui": {"layout":"vertical","labelsOnTop": true}, "fields": [
        {"type":"text","key":"command","label":"Commande (ex. /hp)","description":"Commande à écouter (ex.: /hp).","col":{"xs":24}},
        {"type":"text","key":"path","label":"Chemin d’endpoint","description":"Chemin d’URL du webhook entrant.","col":{"xs":24},"default":"/hooks/slack"}
      ] } }
  ]
}
