              "xs": 24
            },
            "secret": true
          },
          {
            "type": "text",
            "key": "incomingWebhookUrl",
            "label": "URL du webhook entrant",
            "description": "URL du webhook entrant Teams.",
            "col": {
              "xs": 24
            }
          }
        ],
        "displayTitle": false,
        "displayDescription": false
      }
    }
