    {
      "key": "google_ai_classify",
      "name": "googleAiClassify",
      "schemaVersion": 2,
      "title": "Classifier un texte",
      "type": "function",
      "nodeKind": "function",
      "category": "AI",
      "providerKey": "google_ai",
      "output_array_field": "categories",
      "outputSchema": [
        {
          "key": "category",
          "type": "text",
          "label": "Catégorie"
        },
        {
          "key": "confidence",
          "type": "number",
          "label": "Confiance"
        },
        {
          "key": "explanation",
          "type": "textarea",
          "label": "Explication"
        }
      ],
      "inputHandles": [
        {
          "id": "in",
          "name": "In",
          "type": "any",
          "accepts": [
            "any"
          ]
        }
      ],
      "description": "Classifier un texte dans une catégorie via Google Gemini",
      "authorize_catch_error": true,
      "args": {
        "displayTitle": false,
        "displayDescription": false,
        "title": "Classifier un texte",
        "ui": {
          "layout": "vertical",
          "labelsOnTop": true
        },
        "fields": [
          {
            "type": "select",
            "key": "model",
            "label": "Modèle",
            "description": "Modèle Gemini à utiliser.",
            "col": {
              "xs": 24
            },
            "options": [
              {
                "label": "Gemini 2.0 Flash",
                "value": "gemini-2.0-flash"
              },
              {
                "label": "Gemini 2.0 Flash Lite",
                "value": "gemini-2.0-flash-lite"
              },
              {
                "label": "Gemini 1.5 Pro",
                "value": "gemini-1.5-pro"
              },
              {
                "label": "Gemini 1.5 Flash",
                "value": "gemini-1.5-flash"
              }
            ],
            "default": "gemini-2.0-flash",
            "expression": {
              "allow": true,
              "defaultMode": "val"
            }
          },
          {
            "type": "textarea",
            "key": "system",
            "label": "Système",
            "description": "Instructions système (optionnel).",
            "col": {
              "xs": 24
            }
          },
          {
            "type": "textarea",
            "key": "text",
            "label": "Texte à classifier",
            "description": "Le texte que le modèle doit classifier.",
            "col": {
              "xs": 24
            },
            "validators": [
              {
                "type": "required"
              }
            ]
          },
          {
            "type": "section",
            "title": "Catégories",
            "key": "categories",
            "mode": "array",
            "array": {
              "initialItems": 2,
              "minItems": 2,
              "controls": {
                "add": {
                  "kind": "text",
                  "text": "Ajouter une catégorie"
                },
                "remove": {
                  "kind": "icon"
                }
              }
            },
            "fields": [
              {
                "type": "text",
                "key": "name",
                "label": "Nom",
                "col": {
                  "xs": 12
                },
                "validators": [
                  {
                    "type": "required"
                  }
                ]
              },
              {
                "type": "text",
                "key": "description",
                "label": "Description",
                "col": {
                  "xs": 12
                }
              },
              {
                "type": "text",
                "key": "_id",
                "label": "ID",
                "col": {
                  "xs": 24
                },
                "visibleIf": {
                  "==": [
                    {
                      "var": "name"
                    },
                    "__never_visible__"
                  ]
                }
              }
            ],
            "col": {
              "xs": 24
            },
            "description": "Les catégories de classification.",
            "grid": {
              "gutter": 16
            },
            "ui": {
              "layout": "vertical"
            }
          }
        ]
      },
      "subtitle": "Classification",
      "group": "Classification",
      "tags": [
        "google",
        "gemini",
        "classification",
        "ai"
      ],
      "risk": "safe",
      "riskReason": "Appel LLM lecture (coût tokens)"
