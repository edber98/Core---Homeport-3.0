{
  "connector": "acme-crm",
  "providerKey": "acme_crm",
  "providerName": "Acme CRM",
  "resources": [
    {
      "key": "contact",
      "title": "contact",
      "titlePlural": "contacts",
      "basePath": "/contacts",
      "defaultActions": ["list", "get", "create", "update", "delete", "search"],
      "fields": [
        { "key": "email", "type": "email", "label": "Email", "description": "Adresse email." },
        { "key": "phone", "type": "tel", "label": "Téléphone", "description": "Numéro de téléphone." }
      ],
      "actions": [
        {
          "key": "upsert_contact",
          "action": "upsert",
          "method": "POST",
          "path": "/contacts/upsert",
          "title": "Upsert un contact",
          "output": "item",
          "args": [
            {
              "key": "body",
              "type": "json",
              "label": "Payload",
              "description": "JSON de upsert contact.",
              "required": true,
              "in": "body"
            }
          ]
        }
      ]
    },
    {
      "key": "deal",
      "title": "deal",
      "titlePlural": "deals",
      "basePath": "/deals",
      "defaultActions": ["list", "get", "create", "update", "delete"],
      "actions": [
        {
          "key": "list_live_deals",
          "action": "list",
          "method": "GET",
          "path": "/deals/live",
          "title": "Lister les deals live",
          "output": "list",
          "disableDefaultArgs": true,
          "args": [
            {
              "key": "limit",
              "type": "number",
              "label": "Limite",
              "description": "Nombre max d'éléments.",
              "required": false,
              "in": "query"
            },
            {
              "key": "offset",
              "type": "number",
              "label": "Offset",
              "description": "Décalage de pagination.",
              "required": false,
              "in": "query"
            }
          ]
        }
      ]
    }
  ]
}
